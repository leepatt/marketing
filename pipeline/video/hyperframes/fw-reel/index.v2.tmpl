<!doctype html>
<html lang="en" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=1080, height=1920" />
    <title>Craftons Formwork Builder soft launch reel v2</title>
    <script src="vendor/gsap.min.js"></script>
    <link rel="stylesheet" href="tokens-root.css" /><link rel="stylesheet" href="fonts/aeonik.css" />
    <style>
      @font-face { font-family: "Inter"; src: url("fonts/inter-latin-500-normal.woff2") format("woff2"); font-weight: 500; }
      @font-face { font-family: "JetBrains Mono"; src: url("fonts/jetbrains-mono-latin-500-normal.woff2") format("woff2"); font-weight: 500; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1080px; height: 1920px; overflow: hidden; background: var(--white); }
      #root { position: relative; width: 1080px; height: 1920px; overflow: hidden; background: var(--white); }
      .clip { position: absolute; inset: 0; width: 1080px; height: 1920px; }
      video.clip { object-fit: cover; }
      #intro { transform-origin: 50% 42%; }
      #demo { transform-origin: 50% 60%; background: var(--white); }
      .ground-dark { background: var(--craftons-green-900); color: var(--fg-invert); }
      /* hero card */
      .band { position: absolute; left: 0; top: 760px; width: 1080px; height: 460px; overflow: hidden; }
      .band img { position: absolute; left: 0; top: -20px; width: 1080px; height: auto; transform-origin: 40% 50%; }
      .eyebrow { font-family: var(--font-mono); font-weight: 500; font-size: 26px; letter-spacing: var(--tracking-widest); text-transform: uppercase; color: var(--craftons-line-green); }
      .title { font-family: var(--font-display); font-weight: 500; font-size: 104px; line-height: 1.02; letter-spacing: var(--tracking-tighter); color: var(--white); }
      .sub { font-family: var(--font-display); font-weight: 500; font-size: 44px; line-height: 1.2; letter-spacing: var(--tracking-tight); color: var(--paper-2); }
      .hero-eyebrow { position: absolute; left: 80px; top: 400px; } .hero-title { position: absolute; left: 80px; top: 446px; width: 920px; } .hero-sub { position: absolute; left: 80px; top: 590px; width: 920px; }
      /* PIP */
      #pip { position: absolute; left: 740px; top: 40px; width: 300px; height: 375px; overflow: hidden; border-radius: 24px; box-shadow: var(--shadow-3); background: var(--paper); }
      #pip-video.clip { position: absolute; inset: auto; left: -103px; top: -244px; width: 506px; height: 900px; object-fit: cover; }
      /* end card */
      .motif { position: absolute; inset: 0; width: 1080px; height: 1920px; }
      .motif path { fill: none; stroke: var(--craftons-line-green); stroke-width: 3; stroke-linecap: round; }
      .display { font-family: var(--font-display); font-weight: 500; font-size: 96px; line-height: 1.05; letter-spacing: var(--tracking-tighter); color: var(--white); }
      .display-2 { font-family: var(--font-display); font-weight: 500; font-size: 56px; line-height: 1.15; letter-spacing: var(--tracking-tight); color: var(--paper-2); }
      .stack { position: absolute; left: 80px; width: 920px; } .stack > * + * { margin-top: var(--sp-6); }
      .wordmark { position: absolute; left: 80px; top: 1380px; font-family: var(--font-display); font-weight: 500; font-size: 76px; letter-spacing: -0.04em; color: var(--white); }
      .url { position: absolute; left: 80px; top: 1478px; font-family: var(--font-mono); font-weight: 500; font-size: 26px; letter-spacing: var(--tracking-wider); color: var(--craftons-line-green); }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="{{TOTAL}}" data-width="1080" data-height="1920">
      <!-- 1. Lee full-screen until he says "Formwork Builder" -->
      <video id="intro" class="clip" data-start="0" data-duration="{{T_FW}}" data-track-index="1" src="assets/take.mp4" muted playsinline></video>

      <!-- 2. hero card on "Formwork Builder" -->
      <section id="hero" class="clip ground-dark" data-start="{{T_FW}}" data-duration="{{T_HERO_DUR}}" data-track-index="1">
        <div class="eyebrow hero-eyebrow" id="hero-eb">New from Craftons</div>
        <div class="title hero-title" id="hero-t">Formwork Builder</div>
        <div class="band"><img id="hero-img" src="assets/hero.png" alt="" /></div>
        <div class="sub hero-sub" id="hero-s">Complete curved formwork. Configured online. Delivered ready to assemble.</div>
      </section>

      <!-- 3. the builder, with Lee as a PIP top-right -->
      <video id="demo" class="clip" data-start="{{T_SHAPE}}" data-duration="{{DEMO_LEN}}" data-track-index="1" src="assets/demo.mp4" muted playsinline></video>
      <div id="pip" style="opacity:0">
        <video id="pip-video" class="clip" data-start="{{T_SHAPE}}" data-duration="{{DEMO_LEN}}" data-media-start="{{T_SHAPE}}" data-track-index="2" src="assets/take.mp4" muted playsinline></video>
      </div>

      <!-- voiceover: the whole cut -->
      <audio id="vo" data-start="0" data-duration="{{T_END}}" data-track-index="3" data-volume="1" src="assets/vo.m4a"></audio>

      <!-- 4. end card -->
      <section id="end" class="clip ground-dark" data-start="{{T_ENDCARD}}" data-duration="4.6" data-track-index="2">
        <svg class="motif" id="motif" viewBox="0 0 1080 1920" aria-hidden="true" data-layout-allow-overflow></svg>
        <div class="stack" style="top: 560px">
          <div class="eyebrow" id="end-eyebrow">Formwork Builder</div>
          <div class="display" id="end-h1">Design it. Price it. Order it.</div>
          <div class="display-2" id="end-h2">Curved formwork, cut to your set-out. Link in bio.</div>
        </div>
        <div class="wordmark" id="end-mark">Craftons</div>
        <div class="url" id="end-url">craftons.com.au</div>
      </section>
    </div>
    <script>
      (function () { const svg = document.getElementById("motif"), NS = "http://www.w3.org/2000/svg"; const w = 760, h = 980, r = 340;
        const d = `M ${r} 0 H ${w - r} A ${r} ${r} 0 0 1 ${w} ${r} V ${h - r} A ${r} ${r} 0 0 1 ${w - r} ${h} H ${r} A ${r} ${r} 0 0 1 0 ${h - r} V ${r} A ${r} ${r} 0 0 1 ${r} 0 Z`;
        for (let i = 0; i < 26; i++) { const t = i / 25; const p = document.createElementNS(NS, "path"); p.setAttribute("d", d);
          p.setAttribute("transform", `translate(${(160 - (-300 + 620 * t)).toFixed(1)} ${(1150 - 1250 * t).toFixed(1)}) rotate(${(22 - 14 * t).toFixed(2)} ${w / 2} ${h / 2}) scale(${(0.82 + 0.3 * t).toFixed(3)})`);
          p.style.opacity = String(0.10 + 0.55 * t); svg.appendChild(p); } })();
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      const T_FW = {{T_FW}}, T_SHAPE = {{T_SHAPE}}, T_END = {{T_ENDCARD}};
      // 1. slow push on Lee
      tl.fromTo("#intro", { scale: 1.06 }, { scale: 1.15, duration: T_FW, ease: "none" }, 0);
      // 2. hero card
      tl.fromTo("#hero-img", { scale: 1.0, x: 0 }, { scale: 1.16, x: -60, duration: {{T_HERO_DUR}}, ease: "none" }, T_FW);
      tl.from("#hero-eb", { opacity: 0, y: 16, duration: 0.35 }, T_FW + 0.05);
      tl.from("#hero-t", { opacity: 0, y: 30, duration: 0.5, ease: "power3.out" }, T_FW + 0.1);
      tl.from("#hero-s", { opacity: 0, y: 20, duration: 0.45, ease: "power3.out" }, T_FW + 0.6);
      // 3. builder punch-ins (relative to the demo clip) + PIP entrance
      const punch = (t, s, oy, dur = 0.9) => tl.to("#demo", { scale: s, transformOrigin: `50% ${oy}%`, duration: dur, ease: "power2.inOut" }, T_SHAPE + t);
      tl.set("#pip", { opacity: 0, x: 40 }, 0);
      tl.to("#pip", { opacity: 1, x: 0, duration: 0.5, ease: "power3.out" }, T_SHAPE + 0.1);
      tl.to("#pip", { opacity: 0, duration: 0.4 }, T_END);
      punch({{P_DIMS}}, 1.06, 64); punch({{P_DIMS_OUT}}, 1.0, 50);
      punch({{P_BR}}, 1.06, 62); punch({{P_BR_OUT}}, 1.0, 50);
      punch({{P_FW}}, 1.05, 62); punch({{P_FW_OUT}}, 1.0, 50);
      punch({{P_MODEL}}, 1.06, 30); punch({{P_MODEL_OUT}}, 1.0, 50);
      // 4. end card
      tl.from("#end", { opacity: 0, duration: 0.6, ease: "power1.out" }, T_END);
      tl.from("#end-eyebrow", { opacity: 0, y: 20, duration: 0.5 }, T_END + 0.4);
      tl.from("#end-h1", { opacity: 0, y: 26, duration: 0.6, ease: "power3.out" }, T_END + 0.6);
      tl.from("#end-h2", { opacity: 0, y: 26, duration: 0.6, ease: "power3.out" }, T_END + 1.4);
      tl.from("#end-mark", { opacity: 0, y: 20, duration: 0.6, ease: "power3.out" }, T_END + 2.1);
      tl.from("#end-url", { opacity: 0, y: 20, duration: 0.6, ease: "power3.out" }, T_END + 2.3);
      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
